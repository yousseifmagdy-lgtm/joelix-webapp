{
  "id": "/",
  "name": "Joelix Video Game",
  "short_name": "Joelix",
  "description": "A connected pixel life RPG with Main, Optional and Daily Bonus quests, a future-buy wishlist, coins, XP and wellness tracking.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f4f1e9",
  "theme_color": "#f4f1e9",
  "orientation": "any",
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "categories": ["lifestyle", "productivity", "health"],
  "icons": [
    {
      "src": "/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
